# macOS
.DS_Store
.AppleDouble
.LSOverride

# Build artifacts & caches
build/
bin/
gen/
out/
*.class
*.log
*.tmp
*.idsig
*.apk

# IDE files
.idea/
*.iml
.gradle/
local.properties

# Private credentials (never committed to public repository)
*.private.key
*.private.json

# Release Keystores & Properties (keep debug.keystore for dev builds)
*.jks
*.keystore
!launcher/debug.keystore
keystore.properties


# Personal branding and secrets live outside the repo (~/.cinetv); never commit them
signature_logo.png
ic_user_signature.xml
private-assets/
*.env
.env*
google-services.json

# Personal brand assets, signatures, photos, and private logos (never commit to public GitHub)
launcher/assets/brand/*
!launcher/assets/brand/.gitkeep
launcher/assets/remote/creator.jpg
launcher/assets/remote/signature.png
docs/remote/static/creator.jpg
docs/remote/static/signature.png
docs/media/nuvio-signature.jpg
*.svg
*alptugflix*
*signature*.png
*creator*.jpg

# Local tooling
.claude/

# Written by install.sh / personalize.py for the TV being set up (personal, regenerated each run)
debloat-journal.txt
nuvio-collections.json
nuvio-preferences.json
cinetv-profile.json
