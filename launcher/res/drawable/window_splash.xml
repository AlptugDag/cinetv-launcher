<?xml version="1.0" encoding="utf-8"?>
<!-- The window Android shows while CineTV starts (or comes back after the TV closed it): the opening's own logo on
     black (no card around it), so it runs straight on into the animated opening. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/black" />
    <item>
        <bitmap android:src="@drawable/window_logo" android:gravity="center" android:filter="true" />
    </item>
</layer-list>
